[
  {
    "bindings": {
      "cmd-shift-g": [
        "task::Spawn",
        {
          "task_name": "LazyGit",
          "reveal_target": "center"
        }
      ]
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "cmd-e": "workspace::ToggleZoom"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "cmd-n": "workspace::NewTerminal"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "shift-enter": [
        "terminal::SendText",
        "\u001b\r"
      ]
    }
  }
]
